{
  "info": {
    "_postman_id": "7e715c24-d6d3-4108-807c-fdf1cc7ee776",
    "name": "SBA301 Assignment 03 - LuanLH",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Requests create temporary records and delete them at the end. Start the backend with the sample accounts from README."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8083/api"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "invalidToken",
      "value": "invalid.jwt.token"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", String(Date.now()));",
          "  const start = new Date(); start.setDate(start.getDate() + 90);",
          "  const end = new Date(start); end.setDate(end.getDate() + 2);",
          "  pm.collectionVariables.set(\"startDate\", start.toISOString().slice(0,10));",
          "  pm.collectionVariables.set(\"endDate\", end.toISOString().slice(0,10));",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Public room types",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/public/room-types",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "{",
              "const assignmentResponse = pm.response.json();",
              "pm.collectionVariables.set(\"roomTypeId\", assignmentResponse[0].id);",
              "}",
              ""
            ]
          }
        }
      ]
    },
    {
      "name": "02 Staff login from properties",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"staff@hotel.local\",\n  \"password\": \"Staff@123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "{",
              "const assignmentResponse = pm.response.json();",
              "pm.collectionVariables.set(\"staffToken\", assignmentResponse.token);",
              "}",
              ""
            ]
          }
        }
      ]
    },
